{
  "name": "yandex-metrika-mcp-server",
  "mcpName": "io.github.artgas1/yandex-metrika-mcp-server",
  "version": "3.2.1",
  "description": "MCP-сервер к API Яндекс Метрики: 108 методов, узкая поверхность по умолчанию (Stat, Management, Logs)",
  "main": "./build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node ./build/index.js",
    "spec:fetch": "node tools/fetch-docs.mjs",
    "spec:build": "node tools/parse-spec.mjs",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "smoke": "node tools/smoke.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node ./build/index.js",
    "protocol": "tsc && node --test test/protocol.test.mjs",
    "prepublishOnly": "npm test",
    "spec:diff": "node tools/diff-spec.mjs",
    "mcpb": "node tools/build-mcpb.mjs --pack",
    "graphic": "node tools/build-graphic.mjs --gif"
  },
  "keywords": [
    "yandex",
    "metrika",
    "yandex-metrika",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "analytics",
    "web-analytics"
  ],
  "author": "Artem Gasparyan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artgas1/yandex-metrika-mcp.git"
  },
  "bin": {
    "yandex-metrika-mcp": "build/index.js"
  },
  "files": [
    "build",
    "spec",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "contributors": [
    "Vadim Bezymianyi (upstream author of yandex-metrika-mcp)"
  ],
  "homepage": "https://github.com/artgas1/yandex-metrika-mcp#readme",
  "bugs": {
    "url": "https://github.com/artgas1/yandex-metrika-mcp/issues"
  }
}
